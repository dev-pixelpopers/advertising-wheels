# ⚠  TEMPLATE ONLY — PLACEHOLDER VALUES. NEVER PUT REAL SECRETS HERE.
#
# This file IS committed to git and pushed to GitHub. Anything written in it
# becomes public to everyone with repo access, permanently, in history.
#
# Real values go in:
#   • .env.local          for local development  (gitignored, never committed)
#   • your host's env settings  for production   (Vercel/Netlify/cPanel UI)
#
# Note: a file named .env.example is NEVER read by the application. Next.js
# only loads .env, .env.local, .env.development and .env.production.

# ── SMTP ────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com

# 587 = STARTTLS (usual). 465 = implicit TLS. The code selects the right
# mode from this number, so it must match what your provider expects.
SMTP_PORT=587

# The account that authenticates.
# Gmail / Google Workspace: this is the full address, and SMTP_PASS must be a
# 16-character App Password (lowercase letters only, generated at
# https://myaccount.google.com/apppasswords with 2-Step Verification on).
# A normal account password is always rejected with 535-5.7.8.
SMTP_USER=user@example.com
SMTP_PASS=

# ── Addresses ───────────────────────────────────────────────────────────
# Where inquiries land. Comma-separate for several recipients.
CONTACT_TO_EMAIL=inbox@example.com

# What the message is sent AS. This must be the SMTP_USER address itself, or
# an alias that account has verified under "Send mail as" — providers reject
# anything else as spoofing. Defaults to SMTP_USER when unset.
# The visitor's address goes in Reply-To, never here.
CONTACT_FROM_EMAIL=user@example.com
