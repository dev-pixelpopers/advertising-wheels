# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template carries no secrets and documents what the app needs.
!.env.example

# Newsletter signups, written at runtime by /api/subscribe. This is personal
# data — it must never be committed, and it is not the system of record either
# (the notification emails are). See src/lib/subscribers.ts.
/data/subscribers.json
/data/subscribers.json.*.tmp

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Camera-original client photography (1.2GB) — webp derivatives live in public/assets/images/clients
originals/
